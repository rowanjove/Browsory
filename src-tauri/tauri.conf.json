{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Browsory",
  "version": "0.2.0",
  "identifier": "com.browsory.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Browsory - 浏览足迹",
        "width": 1280,
        "height": 800,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https: asset: http://asset.localhost; connect-src 'self' https: http: ipc:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "license": "Apache-2.0",
    "licenseFile": "../LICENSE",
    "resources": {
      "../NOTICE": "licenses/NOTICE",
      "../docs/THIRD_PARTY_NOTICES.md": "licenses/THIRD_PARTY_NOTICES.md",
      "openssl/LICENSE.txt": "licenses/OpenSSL-LICENSE.txt",
      "../docs/licenses/sqlcipher-src/LICENSE": "licenses/SQLCipher-LICENSE",
      "../docs/licenses/sqlcipher-src/LICENSE-sqlcipher": "licenses/LICENSE-sqlcipher",
      "../docs/licenses/sqlcipher-src/LICENSE-libtomcrypt": "licenses/LICENSE-libtomcrypt",
      "../docs/licenses/webpki-roots/LICENSE": "licenses/webpki-roots-LICENSE.txt"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {}
}
